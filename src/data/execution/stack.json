  "code": "PAIRS = {\")\": \"(\", \"]\": \"[\"}\n\n\ndef balanced(text):\n    stack = []\n    for char in text:\n        if char in \"([\":\n            stack.append(char)\n        else:\n            if not stack or stack.pop() != PAIRS[char]:\n                return False\n    return not stack\n\n\nprint(balanced(\"([])\"))\n",
